rules_version = '2';
// 클로즈 게이트 Firestore 보안 규칙
// - 로그인한 사람(익명 포함)만 게이트 · 레이드 · 기록을 읽고 쓸 수 있다.
// - 개인 저장 기록(data/users/{uid}/save)은 본인만 읽고 쓸 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // 함께 닫는 게이트
    match /gates/{gateId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.size() < 200;
    }
    // 레이드 · 봉인 기록 · 레이드 결과
    match /world/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    // 동시에 봉인할 때 한 사람만 처리하도록 거는 짧은 잠금
    match /locks/{lockId} {
      allow read, write: if signedIn();
    }
    // 지금 접속한 요원 (본인 문서만 쓸 수 있다)
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // 개인 저장 기록
    match /data/users/{uid}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
